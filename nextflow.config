// Default parameters for portable local and HPCC runs.
params {
    mode = 'qc'
    outdir = 'results'
    fastq_dir = "results/fastqs"
    transcriptome = System.getenv('TRANSCRIPTOME') ?: 'references/refdata-gex-GRCh38-2024-A'
    fastqc_module = 'fastqc/0.11.5'
}

// Nextflow-managed environments; cache stays on the project drive.
conda.enabled = true
conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.conda/nextflow"

profiles {
    cluster {
        process {
            executor = 'slurm'
            queue = 'general'
            scratch = true
            stageInMode = 'symlink'

            withName: FASTQC {
                cpus = 4
                memory = '8 GB'
                time = '4h'
                queue = 'general'
            }
            withName: MULTIQC_RAW {
                cpus = 2
                memory = '4 GB'
                time = '2h'
                queue = 'general'
            }
            withName: CELLRANGER_COUNT {
                scratch = false
                maxForks = 2
                cpus = 16
                memory = '128 GB'
                time = '48h'
                queue = 'general'
            }
            withName: MULTIQC_FINAL {
                cpus = 2
                memory = '8 GB'
                time = '2h'
                queue = 'general'
            }
            withName: 'SEURAT_ANALYSIS|SCANPY_ANALYSIS' {
                cpus = 4
                memory = '16 GB'
                time = '4h'
                queue = 'general'
            }
        }

        apptainer {
            enabled = false
            autoMounts = true
            cacheDir = "${System.getProperty('user.home')}/.apptainer_cache"
        }
    }
}
